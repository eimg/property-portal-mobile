# Optional override for the versioned API base URL.
# iOS Simulator and web default to http://127.0.0.1:4000/api/v1.
# Android emulator defaults to http://10.0.2.2:4000/api/v1.
# On a physical device, point this at your computer and start the API with HOST=0.0.0.0.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
